function onPlayerStateChange(event) {
    if (event.data == YT.PlayerState.PLAYING) {
        clearTimeout(_tm4hiLite);
        _tm4hiLite = setTimeout(highlightSubtitles, 500);
    }
}

function highlightSubtitles() {
    clearTimeout(_tm4hiLite);
    let currentTime = parseInt(player.getCurrentTime());
    let subtitles = document.querySelectorAll('.subtitle');
    let anchor = -1;
    subtitles.forEach(function(subtitle) {
        let start = parseFloat(subtitle.getAttribute('data-start'));
        let end = parseFloat(subtitle.getAttribute('data-end'));

        if (isNaN(start)){
            start = parseFloat(subtitle.getAttribute('data-timestamp'));
            end = start + 2;
        }
        if (_prevStart == start){
//            if (_osX != "Linux" && _osX !="macOS" && _osX !="Windows"){
                if (currentTime >= start  && currentTime < end + 4) {
                    anchor = subtitle;
                    scrollHeight = checkVisible(anchor, scrollHeight);
                    scrollBy(0, scrollHeight);
//                }
            }

        }else if (currentTime >= start - 1 && currentTime < end) {
            _prevStart = start;
            subtitle.classList.add('highlight');
        } else {
            subtitle.classList.remove('highlight');
        }
    });
    checkRep(currentTime);
    _tm4hiLite = setTimeout(highlightSubtitles, 100);
}

function checkVisible(self, scrollHeight){
    let topPos = self.getBoundingClientRect().top;
    let bottomPos = self.getBoundingClientRect().bottom;
    let startPos = 4;
    if (_osX != "Linux" && _osX !="macOS" && _osX !="Windows"){
        let startPos = 6;
    }
    if(topPos < 10){
        scrollHeight -= 1;
//        scrollHeight = 0;
    }else if(topPos < (window.innerHeight / startPos)){
        if(scrollHeight > 1){
            scrollHeight -= 2;
        }
    }else if(topPos < (window.innerHeight / startPos)*1.3){
        if(scrollHeight > 1){
            scrollHeight -= 1;
        }
    }else if (topPos > window.innerHeight - 800 / startPos){
            scrollHeight += 1;
    }else if (topPos > (window.innerHeight / startPos)*1.51){
//        if(scrollHeight < 14){
            scrollHeight += 1;
//        }
    }
    return(scrollHeight);
}


