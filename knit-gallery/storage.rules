rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 画像は公開で閲覧できるようにする（一覧・詳細のため）
    // アップロード（書き込み）は本人のフォルダ配下のみ許可。
    match /posts/{userUid}/{postId}/photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && userUid == request.auth.uid;
    }

    // 上記以外は拒否（安全側）
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

