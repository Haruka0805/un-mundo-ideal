const ham = document.querySelector('#js-hamburger'); //js-hamburgerの要素を取得し、変数hamに格納
const nav = document.querySelector('#js-nav'); //js-navの要素を取得し、変数navに格納

$(document).ready(function() {
  //今日
  var now = new Date();
  var y = now.getFullYear();
  var m = now.getMonth()+1;
  var d = now.getDate();
  $('#js_card_item_time_1').text(y + '/' + m + '/' + d);

  //5日前
  now.setDate(now.getDate()-5);
  y = now.getFullYear();
  m = now.getMonth()+1;
  d = now.getDate();
  $('#js_card_item_time_2').text(y + '/' + m + '/' + d);

  //10日前
  now.setDate(now.getDate()-5);
  y = now.getFullYear();
  m = now.getMonth()+1;
  d = now.getDate();
  $('#js_card_item_time_3').text(y + '/' + m + '/' + d);
});

