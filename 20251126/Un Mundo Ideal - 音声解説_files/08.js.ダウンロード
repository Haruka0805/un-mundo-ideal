function highlightSubtitles () {
  let currentTime = parseInt(player.getCurrentTime())
  let subtitles = document.querySelectorAll('.subtitle')
  subtitles.forEach(function (subtitle) {
    let start = parseInt(subtitle.getAttribute('data-start'))
    let end = parseInt(subtitle.getAttribute('data-end'))

    if (isNaN(start)) {
      start = parseInt(subtitle.getAttribute('data-timestamp'))
      end = start + 1
    }
    if (currentTime == start - 1) {
      prevHilite2normal();
      subtitle.classList.add('box');
      subtitle.classList.add('highlight');
      _prevHilite = subtitle;

    } else if (currentTime == start) {
      clearTimeout(_tm4skip13sec);
      if (_isPofTW) {
        _tm4skip13sec = setTimeout('skip13sec()', 11 * 1000)
      }
      checkVisible(subtitle)
      let child
      for (child of subtitle.childNodes) {
        if (child.nodeType === Node.ELEMENT_NODE) {
          break
        }
      }
      if (child == undefined) {
        alert('999' + subtitle.firstChild.innerHTML)
      } else {
        _currHilitedOtoLine = child.id.replace('L', '').replace('o', '')
      }
//      checkVisible(subtitle)
    } else if (currentTime >= start - 2 && currentTime < end) {
      subtitle.classList.add('highlight')
    } else {
      subtitle.classList.remove('highlight')
    }
  })
  checkRep(currentTime)
  clearTimeout(_tm4hiLite)
  _tm4hiLite = setTimeout(highlightSubtitles, 200)
}

function scrollX (scrollPosition) {
  window.scrollBy({
    top: scrollPosition,
    behavior: 'smooth'
  })
}

function checkVisible (self) {
  const elementRect = self.getBoundingClientRect()
  const topPosition = elementRect.top
  if (_viewportHeight < 480) {
    if (topPosition >= _viewportHeight / 3 || topPosition <= -10) {
      const scrollPosition = topPosition - 20
      scrollX(scrollPosition)
    }
  } else {
    //250 = video height + ctrl height
    if (topPosition >= _viewportHeight - 250 || topPosition <= 10) {
      //            const scrollPosition = topPosition - _viewportHeight / 4;
      const scrollPosition = topPosition - 20
      scrollX(scrollPosition)
    }
  }
}

