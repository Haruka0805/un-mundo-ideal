function writeWdList () {
  let checkedList = ';'
  let cntX = 0
  let buffX2 = ''
  let buffX = ''
  let cnt4subt = 0
  let isFirst = 1
  let urlX
  let reallyFirst = 1
  document.querySelectorAll('.subtitle').forEach(function (line) {
    cnt4subt += 1
    let cnt4subt2 = cnt4subt
    if (cnt4subt < 10) {
      cnt4subt2 = '0' + cnt4subt
    }
    let line2html = line.innerHTML.replace(/ <ruby/g, "\n<ruby").replace(/\+<ruby/g, "\n+\n<ruby")
    let buff = line2html.split('\n')
    if (reallyFirst &&  isFirst) {
        reallyFirst = 0
      buffX += '<button onClick=go2lineCnt8(this) id="W01">L01</button>'
      isFirst = 0
    }
    const regex = /<rt>(.*?)<\/rt>/i
    //        let yomi = "";
    buff.forEach(function (line2) {
      if (line2.includes('<sub>')) {
        if (isFirst) {
          buffX +=
            '<button  class="quiz1" onClick=go2lineCnt8(this) id="W' +
            cnt4subt2 +
            '">L' +
            cnt4subt2 +
            '</button> '
          isFirst = 0
        }
        line2 = line2.split("</sub>")[0]
          .replace(/<u><ruby.*?>/, '')
          .replace('</u>', '')

        let wordSense = line2.split('<sub>')
        const word = wordSense[0].replace("¿", "").replace("¡", "")
          .toLowerCase()
          .replace(/<rt>.*<\/rt>/g, '')
          .replace(/<ruby.*?>/, '')
          .replace('</ruby>', '')
          .trim()
          .replace(/\s/g, '_')

        let sense = wordSense[1].replace(/[.?!,]/g, '')

        const match = line2.match(regex)
        if (match) {
          sense += '<small>' + match[1] + '</small>'
        }

        const wordSpell = word.replace(/_/g, ' ')
        if (!checkedList.includes(';' + word + ';')) {
          buffX +=
            '<button class="quiz1" onClick=speak2("' +
            word +
            '",this,0)>' +
            wordSpell +
            '</button>' +
            sense +
            '&nbsp;\n'
          buffX2 += word + ': ' + sense + '\n'
          checkedList += word + ';'
          cntX += 1
          if (cntX % 10 == 0 && (!_path.includes('31wholeNW/index.html')
          && !_path.includes('11students/index.html'))
          ) {
            urlX = makeQuizLink(buffX2, cntX)
            buffX += '<br>\n' + urlX + '\n<hr>\n'
            buffX2 = ''
            isFirst = 1
          }
        }
      }
    })
  })
//残りの書き出し試験
	urlX = makeQuizLink(buffX2, cntX)
	buffX += '<br>\n' + urlX + '\n<hr>\n'
  buffX += '\n<hr><br>\n'
