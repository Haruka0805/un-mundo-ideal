function getBareText2 (self, childX) {
  let bareText = self.innerHTML
  bareText = bareText.replace(/<b.*?<\/b>/g, '').replace(/\+/g, "")
  bareText = bareText.replace(/<span class="play-button".*?<\/span>/, '')
  bareText = bareText.replace(`<span class="lyric-text">`, '')
  bareText = bareText.replace('</span>', '')
  bareText = bareText
    .replace(/<rt>[^>]*?<\/rt>/g, '')
    .replace(/<sub.*?>[^>]*?<\/sub>/g, '')
  bareText = bareText.replace(/<u>/g, '').replace(/<\/u>/g, '')
  bareText = bareText
    .replace(/<ruby.*?>/g, '')
    .replace(/<\/ruby>/g, '')
    .replace(/\s+/g, ' ')
  if (_lang4dic.includes('kor')) {
    bareText = bareText.replace(/\-/g, '').replace(/\+/g, '')
  }
  player.pauseVideo()
  clearTimeoutAll()
  //音
  if (childX.id.includes('o')) {
    replaceOLofElemLine(childX.id)
    speak(bareText, 100)
  } else {
