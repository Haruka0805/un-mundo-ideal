function playAudio(word, self){
    setAudioColorButtons(self);
    let root = "http://sato.fm.senshu-u.ac.jp/zkiku/12langText/98m4a/" + _lang4dic + "/"
    const audioX = document.getElementById("audioX");
    if(_lang4dic == "1eng"){
        root += word.substr(0,1) + "/";
    }
    word = word.replace(/\(.+\)/g, '').replace(/（.+）/g, '');
    root += word + ".m4a";
    audioX.src = root;

    _audiClickCnt += 1;
    audioX.play();
}

function recTime(){
    dd = new Date();
    var month = dd.getMonth() + 1;
    var day = dd.getDate();
    var hour = dd.getHours();
    var min = dd.getMinutes();
    if (month < 10) { month = "0" + month; }
    if (day < 10) { day = "0" + day; }
    if (hour < 10) { hour = "0" + hour; }
    if (min < 10) { min = "0" + min; }
    strTime = month + "/" + day + " " + hour + ":" + min;
    return(strTime);
}

