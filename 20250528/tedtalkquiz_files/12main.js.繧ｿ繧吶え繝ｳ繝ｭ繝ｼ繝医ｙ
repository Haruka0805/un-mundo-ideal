    let nickName = "SatoHiro" + numX;
    nickName = prompt("2桁授業番号 3桁ID 大文字頭文字2文字(例：54721SH)", nickName);
    const result = nickName.match(/^[a-zA-Z0-9]+$/);
    if (!result){
        alert("111 error: " + nickName);
        const numX =  Math.floor(Math.random() * 100);
        nickName = "SatoHiro" + numX;
    }
    _errorLines = ";;";
    _testKekkaAll = "";
    localStorage.clear();
    return(nickName);
}

