function getLexLines(){
    let tangoData = document.getElementById("textX").value.trim();
    tangoData = tangoData.replace(/\t/g, ": ");
//    const addLangLine = ": " + _lang4dic + ": : \n";
    const addLangLine = ": : : \n";
    tangoData = tangoData.replace(/\n/g, addLangLine);
    tangoData = tangoData + addLangLine;
    const wordLines = tangoData.split(/\n+/);
    return(wordLines);
}

